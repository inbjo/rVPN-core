[server]
bind_address = "0.0.0.0:443"
tls_cert_file = "/opt/rvpn/certs/cert.pem"
tls_key_file = "/opt/rvpn/certs/key.pem"
identity_key_file = "/opt/rvpn/server_identity.key"
websocket_path = "/api/v1/ws"
http_port = 80
redirect_http_to_https = true

[server.rate_limit]
max_connections_per_ip = 500
max_handshakes_per_minute = 2000

[server.network]
nat_enabled = true
dhcp_range = "10.200.0.0/24"

[server.tun]
enabled = false
tun_ip = "10.200.0.1/24"
mtu = 1420
interface_name = "tun0"
dns_servers = [ "1.1.1.1", "8.8.8.8" ]

[server.acme]
enabled   = false
domains   = ["example.com"]
contacts  = ["mailto:ops@example.com"]
cache_dir = "/var/lib/rvpn/acme"